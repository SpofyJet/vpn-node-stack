#!/bin/bash
# spofy-guard 2.3 — ранний фильтр на входе ноды (nft netdev: раньше таблицы соединений и файрвола).
# Пропускает:
#   TCP   новое соединение (SYN) — только на слушающие порты: со знакомого адреса (нода уже отдавала ему данные, память
#         KNOWN_TTL) — сразу; с незнакомого — в пределах общего бюджета SYN_NEW в секунду. Сверх бюджета (идёт атака) первый
#         SYN с незнакомого адреса отбрасывается, а повтор с того же адреса за 4 с проходит: настоящий клиент повторяет сам
#         через секунду, подделанный адрес не повторяет. Один адрес не может занять общий бюджет: больше SRC_SYN новых
#         соединений в секунду с одного адреса — отброс. Остальной TCP идёт дальше как раньше.
#   UDP   на слушающие порты и ответы на свой исходящий UDP (локальный порт помнится 180 с).
#         Hysteria (QUIC): пакеты подключённых клиентов — сразу; начало соединения и прочее от незнакомых — в пределах бюджета,
#         сверх бюджета — то же правило «повтори».
#   ICMP  ответы и ошибки (нужны для подбора размера пакета) и ping — в пределах бюджета. Фрагменты — до 3000 в секунду.
# Отбрасывает: UDP не к нам; SYN на закрытые порты; SYN и QUIC от незнакомых сверх бюджета; TCP с битыми флагами;
#   протоколы кроме TCP/UDP/ICMP; пакеты без соединения (ACK/RST-флуд) — сразу после таблицы соединений, до списков.
# Оборванное соединение (телефон проснулся, сменилась сеть, нода перезагрузилась): клиент шлёт пакет в соединение, которого
#   на ноде уже нет. Нода отвечает ему «сброс» (RST) — приложение переподключается сразу, а не ждёт своего таймаута.
#   Ответов не больше RST_STALE в секунду; при ACK-флуде, когда бюджет занят, ответ получает тот, кто повторил пакет
#   (настоящий клиент повторяет сам через 0,2–1 с, подделанный адрес — нет). Всё остальное без соединения — молча отброс.
# Режимы:
#   observe       поставить в режиме наблюдения: ничего не отбрасывает, только считает и помечает, что отбросил бы
#   measure [с]   сколько пакетов попало бы под отброс и сколько из них «своих» (частей живых соединений)
#   enforce       включить отброс (после observe)
#   boot          поставить с нуля: LEARN секунд учится, потом включает отброс (загрузка сервера, ensure)
#   ensure        по таймеру: вернуть таблицу, если пропала; дописать новые слушающие порты; сохранить память на диск
#   reload        поставить заново с теми же знакомыми адресами и в том же режиме (после обновления скрипта)
#   sysctl on|off две настройки ядра против флуда и их возврат (см. sysctl_on)
#   status | remove
# Настройки (необязательно) — /etc/spofy-guard.conf: EXTRA_TCP, EXTRA_UDP (порты через пробел), HY_PORTS (auto или список),
#   QUIC_FILTER=0 (выключить разбор QUIC, если на Hysteria включат маскировку пакетов), TRUSTED (адреса управления),
#   MGMT_NEW=0 — SSH и API ноды только с адресов управления (TRUSTED и TRUSTED_IPS скрипта защиты), остальным закрыто;
#   SYN_NEW, SYN_KNOWN, QUIC_NEW, QUIC_KNOWN, QUIC_OTHER, MGMT_NEW, RST_STALE (общие бюджеты в секунду), SRC_SYN, SRC_Q (на один адрес), KNOWN_TTL, LEARN.
set -u
VER=2.3; T=spofy_guard; CT=spofy_guard_ct
CONF=${GUARD_CONF:-/etc/spofy-guard.conf}; STATE=${GUARD_STATE:-/var/lib/spofy-guard}; SYSD=${GUARD_SYSCTL_D:-/etc/sysctl.d}
EXTRA_TCP=""; EXTRA_UDP=""; HY_PORTS=auto; QUIC_FILTER=1; TRUSTED=""
SYN_NEW=auto; SYN_KNOWN=3000; QUIC_NEW=200; QUIC_KNOWN=2000; QUIC_OTHER=500; MGMT_NEW=5; ICMP_ECHO=200; KNOWN_TTL=3d; LEARN=30; SEEN=auto; SRC_SYN=100; SRC_Q=100; RST_STALE=500
[ -f "$CONF" ] && . "$CONF"
IF=${GUARD_IF:-$(ip -o -4 route show to default | awk '{print $5; exit}')}
[ -n "$IF" ] || { echo "нет устройства с маршрутом по умолчанию"; exit 1; }
read -r LOW _ < /proc/sys/net/ipv4/ip_local_port_range
mkdir -p "$STATE"
if [ "$SYN_NEW" = auto ]; then   # бюджет × 15 с жизни полуоткрытого соединения должен помещаться в очередь ядра
  b=$(cat /proc/sys/net/ipv4/tcp_max_syn_backlog 2>/dev/null || echo 4096); SYN_NEW=$((b / 24))
  [ "$SYN_NEW" -gt 1000 ] && SYN_NEW=1000; [ "$SYN_NEW" -lt 100 ] && SYN_NEW=100
fi
if [ "$SEEN" = auto ]; then   # память «кто уже стучался»: ~100 байт на адрес, около 1 % ОЗУ на набор
  SEEN=$(awk '/MemTotal/{n=int($2/1024)*100; if(n>1000000)n=1000000; if(n<50000)n=50000; print n}' /proc/meminfo)
fi
P_MGMT='^(sshd|rw-node)$'; P_HY='^(rw-core|xray|hysteria|sing-box)$'
IPRE='^([0-9]{1,3}\.){3}[0-9]{1,3}'

# --- что слушает нода (не на loopback): "порт процесс"
lst() { ss -Hl"$1"np 2>/dev/null | awk '$4!~/^127\./ && $4!~/^\[::1\]/ { n=split($4,a,":"); p="-"; if (match($0,/\(\("[^"]+"/)) p=substr($0,RSTART+3,RLENGTH-4); if (a[n]+0>0) print a[n]+0, p }' | sort -u; }
saved() { cat "$STATE/$1" 2>/dev/null; }
p_mgmt() { { lst t | awk -v r="$P_MGMT" '$2~r{print $1}'; saved tcp_mgmt; } | sort -un; }
p_svc() { { lst t | awk -v r="$P_MGMT" '$2!~r{print $1}'; for p in $EXTRA_TCP; do echo "$p"; done; saved tcp_svc; } | sort -un | grep -vxFf <(p_mgmt); }
p_hy() {
  [ "$QUIC_FILTER" = 1 ] || return 0
  if [ "$HY_PORTS" = auto ]; then { lst u | awk -v r="$P_HY" -v low="$LOW" '$2~r && $1<low{print $1}'; saved hy_ports; } | sort -un
  else for p in $HY_PORTS; do echo "$p"; done | sort -un; fi
}
p_udp() { { lst u | awk -v low="$LOW" '$1<low{print $1}'; echo 68; for p in $EXTRA_UDP; do echo "$p"; done; saved udp_listen; } | sort -un | grep -vxFf <(p_hy); }
p_trusted() { { for a in $TRUSTED; do echo "$a"; done; grep -hs '^TRUSTED_IPS=' /etc/shieldnode/config.conf | cut -d= -f2- | tr -d "\"'" | tr ' ,' '\n\n'; } | grep -E "$IPRE(/[0-9]{1,2})?\$" | sort -u; }
# знакомые адреса: сохранённые + те, с кем сейчас есть соединение на сервисных портах
p_known() {
  { saved known
    ss -Hnt state established 2>/dev/null | awk -v ports=" $(p_svc | tr '\n' ' ')" '{ n=split($3,a,":"); if (index(ports, " " a[n] " ") && match($4, /([0-9]+\.){3}[0-9]+/)) print substr($4, RSTART, RLENGTH) }'
  } | grep -E "$IPRE\$" | sort -u | head -200000
}
els() { local e; e=$(awk 'NF' | paste -sd, -); [ -n "$e" ] && printf '    elements = { %s }\n' "$e"; return 0; }

# правила цепочки после таблицы соединений. $1: accept — наблюдение (только счёт), drop — отброс
pre_rules() {
  [ "$1" = accept ] && echo 'meta mark & 0xffffff00 == 0x00005d00 jump chk'
  if [ "$1" = drop ]; then echo "iif \"$IF\" ct state invalid jump inv"; else echo "iif \"$IF\" ct state invalid counter name c_invalid"; fi
  # продолжение соединения, которого нет в таблице (при loose=0 такой пакет недействителен и попадает в цепочку inv)
  echo "iif \"$IF\" tcp flags & (syn | rst) == 0 ct state new counter name c_pickup"
}
# --- правила. $1: accept — наблюдение, drop — отброс
gen() {
  local v=$1
  cat <<X
table netdev $T
delete table netdev $T
table inet $CT
delete table inet $CT
table netdev $T {
  set tcp_svc {
    type inet_service
$(p_svc | els)
  }
  set tcp_mgmt {
    type inet_service
$(p_mgmt | els)
  }
  set udp_listen {
    type inet_service
$(p_udp | els)
  }
  set hy_ports {
    type inet_service
$(p_hy | els)
  }
  set trusted {
    type ipv4_addr
    flags interval
    auto-merge
$(p_trusted | els)
  }
  set udp_out {
    type inet_service
    flags dynamic,timeout
    timeout 180s
    size 65536
  }
  set quic_known {
    type ipv4_addr . inet_service
    flags dynamic,timeout
    timeout 180s
    size 262144
  }
  set known {
    type ipv4_addr
    flags dynamic,timeout
    timeout $KNOWN_TTL
    size 262144
$(p_known | els)
  }
  set syn_seen {
    type ipv4_addr
    flags dynamic,timeout
    timeout 4s
    size $SEEN
  }
  set q_seen {
    type ipv4_addr
    flags dynamic,timeout
    timeout 4s
    size $SEEN
  }
$(for n in src_k src_r src_q src_qr; do printf '  set %s {\n    type ipv4_addr\n    flags dynamic,timeout\n    timeout 10s\n    size 131072\n  }\n' $n; done)
  set unlisted {
    type inet_service
    flags dynamic,timeout
    timeout 1h
    size 256
  }
$(for c in syn_known syn_new syn_retry syn_first syn_over syn_src syn_closed mgmt_over tcp_flags udp_listen udp_reply udp_miss q_known q_ip q_new q_other q_retry q_first q_over q_src q_ver q_small frag frag_over icmp_over proto otherhost; do echo "  counter c_$c { }"; done)

  chain eg {
    type filter hook egress device "$IF" priority 0; policy accept;
    meta l4proto tcp jump eg_tcp
    meta l4proto udp jump eg_udp
  }
  chain eg_tcp {
    # знакомый адрес = тот, кому сервисный порт отдал данные: соединение дошло до конца, адрес не подделан
    tcp flags & (syn | rst | psh | ack) == psh | ack tcp sport @tcp_svc update @known { ip daddr }
    # самопроверка: нода отвечает на соединение с порта, которого нет в списках
    tcp flags & (syn | ack) == syn | ack tcp sport != @tcp_svc tcp sport != @tcp_mgmt update @unlisted { tcp sport }
  }
  chain eg_udp {
    udp sport @hy_ports jump eg_quic
    update @udp_out { udp sport }
  }
  chain eg_quic {
    # сервер шлёт короткий пакет только клиенту, прошедшему рукопожатие; 50 = размер ответа «сброс» на мусор — его не учим
    @th,64,8 & 0x80 == 0 udp length != 50 update @quic_known { ip daddr . udp dport } update @known { ip daddr }
    accept
  }

  chain in {
    type filter hook ingress device "$IF" priority -480; policy accept;
    # кадры с чужим MAC (хостер льёт на порт чужой трафик): ядро выбросит их само первым же шагом — не гоняем по правилам
    meta pkttype other counter name c_otherhost accept
    meta protocol != ip accept
    ip frag-off & 0x1fff != 0 jump frags
    meta l4proto vmap { tcp : jump tcp_in, udp : jump udp_in, icmp : jump icmp_in }
    counter name c_proto meta mark set 0x5d0c jump miss
  }
  chain frags {
    limit rate 3000/second burst 3000 packets counter name c_frag accept
    counter name c_frag_over meta mark set 0x5d0b jump miss
  }
  chain tcp_in {
    tcp flags & (fin | syn | rst | ack) == syn jump tcp_syn
    tcp flags & (rst | ack) == 0 counter name c_tcp_flags meta mark set 0x5d03 jump miss
    accept
  }
  chain tcp_syn {
    tcp dport @tcp_mgmt jump syn_mgmt
    tcp dport != @tcp_svc counter name c_syn_closed meta mark set 0x5d01 jump miss
    ip saddr @known jump syn_k
    ip saddr @trusted limit rate 300/second burst 600 packets accept
    limit rate $SYN_NEW/second burst $((SYN_NEW * 2)) packets counter name c_syn_new accept
    # бюджет исчерпан — идёт атака: адрес, который уже стучался за последние 4 с, повторяет SYN как настоящий клиент
    ip saddr @syn_seen jump syn_again
    add @syn_seen { ip saddr } counter name c_syn_first meta mark set 0x5d02 jump miss
    counter name c_syn_over meta mark set 0x5d0d jump miss
  }
  chain syn_k {
    # один знакомый адрес не должен занять общий бюджет знакомых
    update @src_k { ip saddr limit rate over $SRC_SYN/second burst $((SRC_SYN * 5)) packets } counter name c_syn_src meta mark set 0x5d10 jump miss
    limit rate $SYN_KNOWN/second burst $((SYN_KNOWN * 5)) packets counter name c_syn_known accept
  }
  chain syn_again {
    update @src_r { ip saddr limit rate over 5/second burst 10 packets } counter name c_syn_src meta mark set 0x5d10 jump miss
    limit rate $((SYN_NEW * 2))/second burst $((SYN_NEW * 4)) packets counter name c_syn_retry accept
    counter name c_syn_over meta mark set 0x5d0d jump miss
  }
  chain syn_mgmt {
    ip saddr @trusted limit rate 300/second burst 600 packets accept
$( [ "$MGMT_NEW" -gt 0 ] && echo "    limit rate $MGMT_NEW/second burst $((MGMT_NEW * 6)) packets accept" )
    counter name c_mgmt_over meta mark set 0x5d04 jump miss
  }
  chain udp_in {
    udp dport @hy_ports jump quic_in
    udp dport @udp_listen counter name c_udp_listen accept
    udp dport @udp_out counter name c_udp_reply accept
    counter name c_udp_miss meta mark set 0x5d05 jump miss
  }
  chain quic_in {
    ip saddr . udp sport @quic_known counter name c_q_known accept
    @th,64,8 & 0xc0 == 0xc0 jump quic_long
    ip saddr @known jump q_k
    limit rate $QUIC_OTHER/second burst $((QUIC_OTHER * 4)) packets counter name c_q_other accept
    ip saddr @q_seen jump q_again
    add @q_seen { ip saddr } counter name c_q_first meta mark set 0x5d08 jump miss
    counter name c_q_over meta mark set 0x5d0e jump miss
  }
  chain quic_long {
    @th,72,32 != 0x00000001 @th,72,32 != 0x6b3343cf counter name c_q_ver meta mark set 0x5d06 jump miss
    @th,72,32 0x00000001 @th,64,8 & 0x30 == 0x00 udp length < 1208 counter name c_q_small meta mark set 0x5d07 jump miss
    ip saddr @known jump q_k
    limit rate $QUIC_NEW/second burst $((QUIC_NEW * 4)) packets counter name c_q_new accept
    ip saddr @q_seen jump q_again
    add @q_seen { ip saddr } counter name c_q_first meta mark set 0x5d08 jump miss
    counter name c_q_over meta mark set 0x5d0e jump miss
  }
  chain q_k {
    update @src_q { ip saddr limit rate over $SRC_Q/second burst $((SRC_Q * 5)) packets } counter name c_q_src meta mark set 0x5d11 jump miss
    limit rate $QUIC_KNOWN/second burst $((QUIC_KNOWN * 3)) packets counter name c_q_ip accept
  }
  chain q_again {
    update @src_qr { ip saddr limit rate over 20/second burst 60 packets } counter name c_q_src meta mark set 0x5d11 jump miss
    limit rate $((QUIC_NEW * 2))/second burst $((QUIC_NEW * 4)) packets counter name c_q_retry accept
    counter name c_q_over meta mark set 0x5d0e jump miss
  }
  chain icmp_in {
    icmp type { echo-reply, destination-unreachable, time-exceeded, parameter-problem } limit rate 3000/second burst 3000 packets accept
    icmp type echo-request limit rate $ICMP_ECHO/second burst $ICMP_ECHO packets accept
    counter name c_icmp_over meta mark set 0x5d0a jump miss
  }
  chain miss {
    $v
  }
}
table inet $CT {
  set ports {
    type inet_service
$({ p_svc; p_mgmt; } | sort -un | els)
  }
  set stale_seen {
    type ipv4_addr
    flags dynamic,timeout
    timeout 4s
    size $SEEN
  }
  set stale_src {
    type ipv4_addr
    flags dynamic,timeout
    timeout 10s
    size 131072
  }
  counter c_invalid { }
  counter c_stale { }
  counter c_stale_retry { }
  counter c_fp { }
  counter c_pickup { }
  set fp {
    type mark
    size 64
    flags dynamic
    counter
  }
  chain pre {
    type filter hook prerouting priority -160; policy accept;
$(pre_rules "$v" | sed 's/^/    /')
  }
  chain inv {
    # пакет в соединение, которого на ноде нет, на слушающий порт: ответить «сброс», остальное — молча отбросить
    tcp flags & (syn | rst | ack) == ack tcp dport @ports jump stale
    counter name c_invalid drop
  }
  chain stale {
    limit rate $RST_STALE/second burst $((RST_STALE * 2)) packets counter name c_stale reject with tcp reset
    # бюджет занят — идёт ACK-флуд: настоящий клиент повторяет свой пакет, подделанный адрес не повторяет
    ip saddr @stale_seen jump stale_again
    add @stale_seen { ip saddr } counter name c_invalid drop
    counter name c_invalid drop
  }
  chain stale_again {
    update @stale_src { ip saddr limit rate over 5/second burst 10 packets } counter name c_invalid drop
    limit rate $RST_STALE/second burst $((RST_STALE * 2)) packets counter name c_stale_retry reject with tcp reset
    counter name c_invalid drop
  }
  chain chk {
    ct state established,related counter name c_fp update @fp { meta mark }
    meta mark set 0
  }
}
X
}

has() { nft list table netdev $T >/dev/null 2>&1; }
enforcing() { nft list chain netdev $T miss 2>/dev/null | grep -qE '^\s*drop$'; }
declare -A C
counters() { C=(); local n p; while read -r n p; do C[$n]=$p; done < <({ nft list counters table netdev $T; nft list counters table inet $CT; } 2>/dev/null | awk '$1=="counter"{n=$2} $1=="packets"{print n, $2}'); }
c() { echo "${C[c_$1]:-0}"; }
setn() { nft list set "$1" "$2" "$3" 2>/dev/null | grep -oE 'expires' | wc -l; }
setv() { nft list set netdev $T "$1" 2>/dev/null | tr -d '\n\t' | sed -nE 's/.*elements = \{([^}]*)\}.*/\1/p' | sed -E 's/ (timeout|expires) [0-9a-z]+//g; s/  */ /g'; }
ports_add() {
  local e
  for s in tcp_svc:p_svc tcp_mgmt:p_mgmt udp_listen:p_udp hy_ports:p_hy; do
    e=$(${s#*:} | paste -sd, -); [ -n "$e" ] && nft add element netdev $T "${s%%:*}" "{ $e }" 2>/dev/null
  done
  # порт Hysteria не должен оставаться в общем списке UDP — иначе на него пройдёт всё
  e=$(p_hy | paste -sd, -); [ -n "$e" ] && nft delete element netdev $T udp_listen "{ $e }" 2>/dev/null
  e=$({ p_svc; p_mgmt; } | sort -un | paste -sd, -); [ -n "$e" ] && nft add element inet $CT ports "{ $e }" 2>/dev/null
  return 0
}
save() {
  local s
  for s in tcp_svc tcp_mgmt udp_listen hy_ports; do setv $s | tr ', ' '\n\n' | grep -E '^[0-9]+$' | sort -un > "$STATE/$s.tmp" && mv "$STATE/$s.tmp" "$STATE/$s"; done
  if [ "${1:-}" = all ] || [ -z "$(find "$STATE/known" -mmin -10 2>/dev/null)" ]; then
    nft list set netdev $T known 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u > "$STATE/known.tmp" && mv "$STATE/known.tmp" "$STATE/known"
  fi
}
sysctl_keys="net.netfilter.nf_conntrack_tcp_loose=0 net.ipv4.tcp_synack_retries=3"
sysctl_on() {
  # nf_conntrack_tcp_loose=0 — пакет без начала соединения (ACK/RST-флуд) не заводит запись и считается недействительным;
  # tcp_synack_retries=3 — полуоткрытое соединение живёт 15 с вместо 63: меньше ответов на подделанные адреса.
  local kv k
  for kv in $sysctl_keys; do k=${kv%%=*}; grep -qs "^$k=" "$STATE/sysctl.prev" || echo "$k=$(sysctl -n "$k" 2>/dev/null)" >> "$STATE/sysctl.prev"; sysctl -qw "$kv" || return 1; done
  { echo "# spofy-guard $VER — возврат: spofy-guard sysctl off"; for kv in $sysctl_keys; do echo "${kv%%=*} = ${kv#*=}"; done; } > "$SYSD/99-z9-spofy-guard.conf"
  # vpn-node при apply ставит loose из своего конфига — задаём то же значение там, чтобы настройки не спорили
  [ -f /etc/node/node.conf ] && ! grep -q '^CONNTRACK_TCP_LOOSE=' /etc/node/node.conf && echo 'CONNTRACK_TCP_LOOSE=0' >> /etc/node/node.conf
  touch "$STATE/sysctl.on"
}
sysctl_off() {
  local kv
  if [ -f "$STATE/sysctl.prev" ]; then while read -r kv; do [ -n "${kv#*=}" ] && sysctl -qw "$kv"; done < "$STATE/sysctl.prev"; fi
  rm -f "$SYSD/99-z9-spofy-guard.conf" "$STATE/sysctl.on" "$STATE/sysctl.prev"
  [ -f /etc/node/node.conf ] && sed -i '/^CONNTRACK_TCP_LOOSE=0$/d' /etc/node/node.conf
  return 0
}
switch() { # accept | drop — одной транзакцией, память (знакомые адреса и пары) не сбрасывается
  { echo "flush chain netdev $T miss"; echo "add rule netdev $T miss $1"
    echo "flush chain inet $CT pre"
    pre_rules "$1" | sed "s/^/add rule inet $CT pre /"
  } | nft -f -
}
report() {
  counters
  local miss=$(( $(c syn_closed) + $(c syn_first) + $(c syn_over) + $(c syn_src) + $(c tcp_flags) + $(c mgmt_over) + $(c udp_miss) + $(c q_ver) + $(c q_small) + $(c q_first) + $(c q_over) + $(c q_src) + $(c icmp_over) + $(c frag_over) + $(c proto) ))
  echo "  TCP, новые соединения: со знакомых адресов $(c syn_known) | с незнакомых $(c syn_new) | при атаке: прошли со второй попытки $(c syn_retry), первая попытка отброшена $(c syn_first), сверх всех бюджетов $(c syn_over) | слишком много с одного адреса $(c syn_src) | на закрытые порты $(c syn_closed) | SSH и API сверх бюджета $(c mgmt_over) | битые флаги $(c tcp_flags)"
  echo "  UDP: на слушающие порты $(c udp_listen) | ответы на наш исходящий $(c udp_reply) | не к нам $(c udp_miss)"
  [ -n "$(setv hy_ports)" ] && echo "  Hysteria: пакеты подключённых $(c q_known) | от незнакомых пар: знакомый адрес $(c q_ip), начало соединения $(c q_new), прочее $(c q_other) | при атаке: со второй попытки $(c q_retry), первая отброшена $(c q_first), сверх бюджетов $(c q_over) | слишком много с одного адреса $(c q_src) | чужая версия $(c q_ver) | короткое начало $(c q_small)"
  echo "  прочее: фрагменты $(c frag), сверх бюджета $(c frag_over) | ICMP сверх бюджета $(c icmp_over) | чужие протоколы $(c proto) | кадры с чужим MAC $(c otherhost) | продолжения без записи в таблице $(c pickup)"
  echo "  пакеты без соединения: молча отброшено $(c invalid) | оборванным соединениям отвечено «сброс» $(c stale), при флуде со второй попытки $(c stale_retry)"
  echo "  под отброс всего: $miss"
}
RN=(_ "SYN на закрытый порт" "первый SYN при атаке" "битые флаги TCP" "SSH/API сверх бюджета" "UDP не к нам" "чужая версия QUIC" "короткое начало QUIC" "QUIC: первая попытка при атаке" "—" "ICMP сверх бюджета" "фрагменты сверх бюджета" "чужой протокол" "SYN сверх всех бюджетов" "QUIC сверх бюджетов" "—" "SYN: слишком много с одного адреса" "QUIC: слишком много с одного адреса")

case "${1:-status}" in
  observe)
    gen accept | nft -f - || { echo "НЕ ПОСТАВИЛОСЬ"; exit 1; }
    echo observe > "$STATE/mode"
    echo "observe: стоит на $IF, отброса нет | TCP сервисные: $(setv tcp_svc) | управление: $(setv tcp_mgmt) | UDP: $(setv udp_listen) | Hysteria: $(setv hy_ports) | знакомых адресов: $(setn netdev $T known) | бюджет SYN с незнакомых: $SYN_NEW/с" ;;
  measure)
    has || { echo "не стоит"; exit 1; }
    N=${2:-30}; nft reset counters table netdev $T >/dev/null; nft reset counters table inet $CT >/dev/null; nft flush set inet $CT fp 2>/dev/null; sleep "$N"
    echo "за $N с:"; report
    fp=$(c fp); echo "  из них «своих» (таблица соединений считает частью живого соединения): $fp"
    [ "$fp" -gt 0 ] && nft list set inet $CT fp | grep -oE '0x[0-9a-f]+ counter packets [0-9]+' | while read -r m _ _ n; do echo "    — ${RN[$((m & 0xff))]:-$m}: $n"; done
    echo "  продолжений соединений без записи в таблице: $(c pickup) (после включения нода ответит на них «сброс», до $RST_STALE в секунду — клиент переподключится сразу)"
    u=$(setv unlisted); echo "  порты, с которых нода отвечает, но которых нет в списках (должно быть пусто): ${u:-—}" ;;
  enforce)
    has || { echo "сначала observe"; exit 1; }
    ports_add; switch drop || exit 1
    echo enforce > "$STATE/mode"; save all; echo "enforce: отброс включён" ;;
  boot)
    gen accept | nft -f - || { echo "НЕ ПОСТАВИЛОСЬ"; exit 1; }
    [ -f "$STATE/sysctl.on" ] && for kv in $sysctl_keys; do sysctl -qw "$kv"; done
    if [ "$(cat "$STATE/mode" 2>/dev/null)" = observe ]; then echo "boot: стоит на $IF в режиме наблюдения"; exit 0; fi
    sleep "$LEARN"; ports_add; switch drop && echo enforce > "$STATE/mode" && echo "boot: стоит на $IF, отброс включён" ;;
  reload)
    has || { echo "не стоит"; exit 1; }
    save all; exec "$0" boot ;;
  ensure)
    if has; then
      ports_add; save
      [ -f "$STATE/sysctl.on" ] && for kv in $sysctl_keys; do [ "$(sysctl -n "${kv%%=*}" 2>/dev/null)" = "${kv#*=}" ] || sysctl -qw "$kv"; done
      [ "$(cat "$STATE/mode" 2>/dev/null)" = enforce ] && ! enforcing && switch drop
      exit 0
    fi
    "$0" boot ;;
  sysctl)
    case "${2:-}" in
      on) sysctl_on && echo "настройки ядра включены: $(for kv in $sysctl_keys; do printf '%s=%s ' "${kv%%=*}" "$(sysctl -n "${kv%%=*}")"; done)" ;;
      off) sysctl_off; echo "настройки ядра возвращены: $(for kv in $sysctl_keys; do printf '%s=%s ' "${kv%%=*}" "$(sysctl -n "${kv%%=*}")"; done)" ;;
      *) for kv in $sysctl_keys; do printf '%s=%s (нужно %s)\n' "${kv%%=*}" "$(sysctl -n "${kv%%=*}")" "${kv#*=}"; done ;;
    esac ;;
  status)
    has || { echo "не стоит"; exit 0; }
    echo "spofy-guard $VER | устройство $IF | отброс $(enforcing && echo включён || echo "выключен (наблюдение)") | настройки ядра: $([ -f "$STATE/sysctl.on" ] && echo включены || echo "не тронуты")"
    echo "  порты: TCP сервисные $(setv tcp_svc) | управление $(setv tcp_mgmt) | UDP $(setv udp_listen) | Hysteria $(setv hy_ports)"
    echo "  память: знакомых адресов $(setn netdev $T known) | подключённых по Hysteria $(setn netdev $T quic_known) | наших UDP-портов $(setn netdev $T udp_out) | бюджеты в секунду: SYN с незнакомых $SYN_NEW, QUIC начало $QUIC_NEW, QUIC прочее $QUIC_OTHER, с одного адреса SYN $SRC_SYN и QUIC $SRC_Q, ответов «сброс» оборванным соединениям $RST_STALE; память повторов до $SEEN адресов"
    [ -d /proc/sys/net/ipv6 ] && ip -6 addr show scope global 2>/dev/null | grep -q inet6 && echo "  ВНИМАНИЕ: на сервере включён IPv6 — этот фильтр разбирает только IPv4"
    echo "  счётчики с момента установки, пакетов:"; report ;;
  remove)
    has && save all
    nft delete table netdev $T 2>/dev/null; nft delete table inet $CT 2>/dev/null
    [ -f "$STATE/sysctl.on" ] && sysctl_off
    [ -z "${GUARD_LAB:-}" ] && systemctl disable --now spofy-guard.timer spofy-guard.service >/dev/null 2>&1
    rm -f "$STATE/mode"; echo "снято" ;;
  *) sed -n 2,27p "$0" ;;
esac
